<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../../build/version.props" />
    <Import Project="../../build/releasenotes.props" />
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Version>$(RpcPackageVersion)</Version>
        <Copyright>Xuanye @ 2017-2022</Copyright>
        <Owners>Xuanye Wong</Owners>
        <Authors>Xuanye Wong</Authors>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>microservice,dotnet,peach,rpc,dotbpe,protocol</PackageTags>
        <Title>DotBPE.Protocol - Binary protocol definitions</Title>
        <Description>Binary protocol definitions for DotBPE RPC framework</Description>
        <PackageProjectUrl>https://github.com/dotbpe/dotbpe</PackageProjectUrl>
        <PackageLicense>https://raw.githubusercontent.com/dotbpe/dotbpe/master/LICENSE</PackageLicense>
        <RepositoryUrl>https://github.com/dotbpe/dotbpe.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>
            $(RpcPackageNotes)
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Peach" Version="0.2.2" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\DotBPE.Abstractions\DotBPE.Abstractions.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\..\icon.png" Link="icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
